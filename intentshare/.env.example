# Copy to .env.local for local development. Never commit real values.
# Without SUPABASE_URL the app uses an in-process Postgres (PGlite) in ./.data.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SERVER_RPC_KEY=
ADMIN_TOKEN=
# Without a key the app runs the deterministic mock AI.
ANTHROPIC_API_KEY=
AI_MODE=live
MODEL_INTENT=claude-haiku-5-5
MODEL_EXTRACT=claude-sonnet-5-5
MODEL_QUICK=claude-haiku-5-5
AI_CALLS_PER_HOUR=60
# Set to false if the IRB does not allow storing unsent draft text (only lengths are kept).
LOG_DRAFT_TEXT=true
