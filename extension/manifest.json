{
  "manifest_version": 3,
  "name": "Core Share (research)",
  "version": "0.1.0",
  "description": "Carnegie Mellon University research prototype: share the part of a YouTube video that matters, with your own note.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel/panel.html" },
  "action": {
    "default_title": "Core Share",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
